# Used for canonical URLs, Open Graph tags, and JSON-LD structured data.
# Set to your real domain (or EC2 public IP) once deployed.
NEXT_PUBLIC_SITE_URL=https://subhankarroy.in

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Takes precedence over GA_ID; configure GA4 inside GTM.
NEXT_PUBLIC_GTM_ID=

# Direct Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX), used only if GTM_ID is empty.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console HTML-tag verification token (the content="..." value only).
# Not needed if the domain is verified via a DNS TXT record.
NEXT_PUBLIC_GSC_VERIFICATION=
